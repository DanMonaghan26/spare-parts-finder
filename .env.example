# Your Anthropic API key — create one at https://platform.claude.com
# (Settings → API keys). It's used server-side only and never sent to browsers.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the Claude model (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL="claude-opus-5-5"

# Optional: override the eSpares search URL if their site changes.
# {q} is replaced with the URL-encoded search terms.
# ESPARES_SEARCH_URL="https://www.espares.co.uk/search.pl?q={q}"
